# Frontend-only release: retain the exact deployed runtime and persistent data.
# RUNTIME_IMAGE must be the reviewed, locally loaded immutable image pin.
ARG RUNTIME_IMAGE
ARG NODE_IMAGE=node@sha256:dc26ae92c9fb15cf6b1d63e20f0944b2efe0f115b20e00be48fb23fceb061c54
FROM ${NODE_IMAGE} AS assets
WORKDIR /app/services/mpp-near-direct
COPY services/mpp-near-direct/package*.json ./
RUN npm ci --ignore-scripts
COPY services/mpp-near-direct/p2 ./p2
COPY services/mpp-near-direct/client ./client
WORKDIR /app/clients/market-playground
COPY clients/market-playground/package*.json ./
RUN npm ci --ignore-scripts
COPY clients/market-playground ./
RUN npm run build

FROM ${RUNTIME_IMAGE}
ARG FRONTEND_REVISION
LABEL ai.bitrouter.frontend.revision=$FRONTEND_REVISION
# Removing the old bundle avoids mixing releases. It does not touch /data.
USER root
RUN rm -rf /app/clients/market-playground/dist
COPY --from=assets /app/clients/market-playground/dist /app/clients/market-playground/dist
USER preview:preview
