+#[test]
+fn append_profile_preserves_busy_physical_capacity_and_rejects_registry_changes() {
+    use bitrouter_market::{admission::*, execution_authorization::FrozenIdentity};
+    let (mut h, _) = pf::setup(false, false);
+    let p = input("busy-profile", 1);
+    place(&mut h, &p); quotes(&mut h, &p); drive(&mut h, 32);
+    let before = serde_json::to_value(h.snapshot()).unwrap();
+    let mut member = fx::member("a", "backend-a");
+    member.offering.offering_id = 1000;
+    let input = RegisterSupplyScope {
+        append_to_existing: true, idempotency_key: "append-profile".into(),
+        scope: PhysicalScope { id: AdmissionScopeId(30), authority_id: fx::AUTH,
+            max_unresolved_requests: 1, members: vec![member] },
+        identities: std::collections::BTreeMap::from([("backend-a".into(), FrozenIdentity {
+            source_epoch: 4, backend_incarnation: "instance-1".into() })]),
+    };
+    h.execute(input.idempotency_key.clone(), ExchangeCommand::RegisterSupplyScope(Box::new(input.clone()))).unwrap();
+    let after = serde_json::to_value(h.snapshot()).unwrap();
+    assert!(!before["state"]["capacity"]["entries"].as_array().unwrap().is_empty());
+    for key in ["entries", "reports"] {
+        assert_eq!(before["state"]["capacity"][key], after["state"]["capacity"][key]);
+    }
+    assert_eq!(h.snapshot().scopes().len(), 2);
+    assert_eq!(h.snapshot().scopes()[&AdmissionScopeId(30)].members.len(), 2);
+    // Identical command replay is harmless; fresh-key duplicate catalog is rejected.
+    h.execute(input.idempotency_key.clone(), ExchangeCommand::RegisterSupplyScope(Box::new(input.clone()))).unwrap();
+    for n in 0..3 {
+        let mut bad = input.clone(); bad.idempotency_key = format!("bad-profile-{n}");
+        if n == 0 { bad.scope.max_unresolved_requests = 2; }
+        if n == 1 { bad.scope.authority_id = ReportAuthorityId(99); }
+        assert!(h.execute(bad.idempotency_key.clone(), ExchangeCommand::RegisterSupplyScope(Box::new(bad))).is_err());
+    }
+    assert_eq!(h.snapshot().scopes()[&AdmissionScopeId(30)].members.len(), 2);
+}
