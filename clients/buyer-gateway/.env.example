BUYER_APP_ORIGIN=http://127.0.0.1:4173
HOST=127.0.0.1
PORT=4180
# Generate once: openssl rand -hex 32. Keep it across restarts; back it up separately.
BUYER_STORAGE_KEY=
BUYER_DATABASE=.state/buyer.sqlite
NEAR_INTENTS_AGENT_API_URL=https://api.agentsonintents.com
NEAR_INTENTS_AGENT_API_KEY=
NEAR_RPC_URL=https://rpc.mainnet.near.org
# Reviewed Market confidential Intents payee, not the app operator's owner account.
BUYER_MERCHANT_ACCOUNT=
# Current Owner Terms URL supplied by the Agent API operator; review before enabling creation.
BUYER_OWNER_TERMS_URL=
BUYER_TOKEN_CONTRACT=usdt.tether-token.near
# Off until a separate wallet-funding acceptance. This does not enable procurement.
BUYER_WALLET_FUNDING_ENABLED=0
BUYER_STATIC_DIR=../market-playground/dist
